# OpenBox Core API
OPENBOX_URL=http://localhost:8086

# LLM provider (required by CrewAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Block agent: all 4 guardrails with block_on_violation=ON, log_violations=ON
OPENBOX_BLOCK_API_KEY=obx_live_...

# Log agent: all 4 guardrails with block_on_violation=OFF, log_violations=ON
OPENBOX_LOG_API_KEY=obx_live_...
