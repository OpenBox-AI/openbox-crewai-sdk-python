# OpenBox Core API
OPENBOX_URL=http://localhost:8086

# LLM provider (required by CrewAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Postgres connection for tests
OPENBOX_DB_TESTER_PG_HOST=localhost
OPENBOX_DB_TESTER_PG_PORT=5432
OPENBOX_DB_TESTER_PG_USER=postgres
OPENBOX_DB_TESTER_PG_PASSWORD=password
OPENBOX_DB_TESTER_PG_DBNAME=openbox

# DB test agent — OPA policy blocks reads from pg_catalog / information_schema.
OPENBOX_DB_TESTER_API_KEY=obx_live_...
OPENBOX_DB_TESTER_DID=did:aip:...
OPENBOX_DB_TESTER_PRIVATE_KEY=base64-ed25519-seed
