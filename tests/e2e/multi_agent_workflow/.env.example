# OpenBox Core API
OPENBOX_URL=http://localhost:8086

# LLM provider (required by CrewAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Four agents for the hierarchical multi-agent workflow.
# Each is DID-provisioned (API key + DID + Ed25519 private key).
OPENBOX_SENIOR_RESEARCHER_API_KEY=obx_live_...
OPENBOX_SENIOR_RESEARCHER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_SENIOR_RESEARCHER_PRIVATE_KEY=base64-32-byte-ed25519-seed

OPENBOX_RESEARCHER_API_KEY=obx_live_...
OPENBOX_RESEARCHER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_RESEARCHER_PRIVATE_KEY=base64-32-byte-ed25519-seed

OPENBOX_DATA_ANALYST_API_KEY=obx_live_...
OPENBOX_DATA_ANALYST_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_DATA_ANALYST_PRIVATE_KEY=base64-32-byte-ed25519-seed

OPENBOX_WRITER_API_KEY=obx_live_...
OPENBOX_WRITER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_WRITER_PRIVATE_KEY=base64-32-byte-ed25519-seed

CREWAI_TRACING_ENABLED=true
