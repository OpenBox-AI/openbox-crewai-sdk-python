# OpenBox Core API
OPENBOX_URL=http://localhost:8086

# LLM provider (required by CrewAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Agent with signing_required=true
OPENBOX_DID_TESTER_API_KEY=obx_live_...
OPENBOX_DID_TESTER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_DID_TESTER_PRIVATE_KEY=base64-32-byte-ed25519-seed

# Agent with DID and signing_required=true but key overriden in test to bad key
OPENBOX_BAD_KEY_TESTER_API_KEY=obx_live_...
OPENBOX_BAD_KEY_TESTER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_BAD_KEY_TESTER_PRIVATE_KEY=base64-32-byte-ed25519-seed

# Agent with no DID
OPENBOX_NO_DID_TESTER_API_KEY=obx_live_...

# Agent with DID but signing_required=false
OPENBOX_NO_SIGNING_TESTER_API_KEY=obx_live_...
OPENBOX_NO_SIGNING_TESTER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_NO_SIGNING_TESTER_PRIVATE_KEY=base64-32-byte-ed25519-seed
