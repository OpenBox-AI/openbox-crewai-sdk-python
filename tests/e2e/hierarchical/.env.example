# OpenBox Core API
OPENBOX_URL=http://localhost:8086

# LLM provider (required by CrewAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Three agents for hierarchical process. Each must be registered in OpenBox.
OPENBOX_SENIOR_RESEARCHER_API_KEY=obx_live_...
OPENBOX_RESEARCHER_API_KEY=obx_live_...
OPENBOX_DATA_ANALYST_API_KEY=obx_live_...
