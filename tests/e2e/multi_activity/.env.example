# OpenBox Core API
OPENBOX_URL=http://localhost:8086

# LLM provider (required by CrewAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Two agents: researcher and writer. Each must be registered in OpenBox.
OPENBOX_RESEARCHER_API_KEY=obx_live_...
OPENBOX_WRITER_API_KEY=obx_live_...
