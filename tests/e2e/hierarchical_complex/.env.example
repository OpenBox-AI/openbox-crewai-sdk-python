# OpenBox Core API
OPENBOX_URL=http://localhost:8086

# LLM provider (required by CrewAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# Postgres for the financial-benchmarks task (defaults match the local stack
# from openbox-backend/docker-compose.yml; override if your stack differs).
E2E_PG_HOST=localhost
E2E_PG_PORT=5432
E2E_PG_USER=postgres
E2E_PG_PASSWORD=password
E2E_PG_DB=openbox

# --- Six agents for the complex hierarchical pipeline ---
# Each agent must be registered in OpenBox AND have its identity provisioned
# (Agent Settings → API Access → Provision Identity in the portal).

# 1. Senior Research Director (manager). Reuses CrewAI E2E - Senior Researcher.
OPENBOX_SENIOR_RESEARCHER_API_KEY=obx_live_...
OPENBOX_SENIOR_RESEARCHER_DID=did:aip:...
OPENBOX_SENIOR_RESEARCHER_PRIVATE_KEY=...

# 2. Market Intelligence Analyst. Reuses CrewAI E2E - Researcher.
OPENBOX_RESEARCHER_API_KEY=obx_live_...
OPENBOX_RESEARCHER_DID=did:aip:...
OPENBOX_RESEARCHER_PRIVATE_KEY=...

# 3. Financial Data Analyst. Reuses CrewAI E2E - Data Analyst.
OPENBOX_DATA_ANALYST_API_KEY=obx_live_...
OPENBOX_DATA_ANALYST_DID=did:aip:...
OPENBOX_DATA_ANALYST_PRIVATE_KEY=...

# 4. Technical Writer. Reuses CrewAI E2E - Writer.
OPENBOX_WRITER_API_KEY=obx_live_...
OPENBOX_WRITER_DID=did:aip:...
OPENBOX_WRITER_PRIVATE_KEY=...

# 5. Senior Editor. Reuses CrewAI E2E - Editor (already exists in 'Crew AI SDK'
# team — provision identity via portal if not already done).
OPENBOX_EDITOR_API_KEY=obx_live_...
OPENBOX_EDITOR_DID=did:aip:...
OPENBOX_EDITOR_PRIVATE_KEY=...

# 6. Compliance Reviewer. Must be created first via openbox-cli or portal:
#   echo '{"agent_name":"CrewAI E2E - Compliance Reviewer","agent_type":"temporal","risk_profile":"medium","team_ids":["8ed6485c-bcfc-448b-8e9f-70c9357aaf58"]}' | openbox-cli create-agent -
# Then provision identity via portal.
OPENBOX_COMPLIANCE_REVIEWER_API_KEY=obx_live_...
OPENBOX_COMPLIANCE_REVIEWER_DID=did:aip:...
OPENBOX_COMPLIANCE_REVIEWER_PRIVATE_KEY=...
