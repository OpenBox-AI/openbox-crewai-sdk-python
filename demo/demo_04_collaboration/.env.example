OPENBOX_URL=https://core.openbox.ai

# Researcher agent
OPENBOX_RESEARCHER_API_KEY=obx_live_...
OPENBOX_RESEARCHER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_RESEARCHER_PRIVATE_KEY=base64-32-byte-ed25519-seed

# Writer agent (task owner; delegates to the others)
OPENBOX_WRITER_API_KEY=obx_live_...
OPENBOX_WRITER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_WRITER_PRIVATE_KEY=base64-32-byte-ed25519-seed

# Editor agent
OPENBOX_EDITOR_API_KEY=obx_live_...
OPENBOX_EDITOR_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_EDITOR_PRIVATE_KEY=base64-32-byte-ed25519-seed

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_NAME=openai/gpt-4o-mini

CREWAI_TRACING_ENABLED=true
