OPENBOX_URL=https://core.openbox.ai

# Researcher agent — provision the identity in the OpenBox Platform
OPENBOX_RESEARCHER_API_KEY=obx_live_...
# Optional IAM v3: unencrypted RSA PEM contents for this agent.
# For IAM-only agents, leave the legacy DID and PRIVATE_KEY values empty.
# OPENBOX_RESEARCHER_WORKLOAD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OPENBOX_RESEARCHER_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_RESEARCHER_PRIVATE_KEY=base64-32-byte-ed25519-seed

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_NAME=openai/gpt-4o-mini

CREWAI_TRACING_ENABLED=true
